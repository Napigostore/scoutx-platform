# Fiwokan Production Environment Configuration Template
NODE_ENV=production

# App Base URL
NEXT_PUBLIC_APP_URL=https://fiwokan.com

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://fiwokan_user:YOUR_POSTGRES_PASSWORD@localhost:5432/fiwokan_db?schema=public

# Authentication & JWT
NEXTAUTH_SECRET=YOUR_RANDOM_NEXTAUTH_SECRET_KEY_MIN_32_CHARS
NEXTAUTH_URL=https://fiwokan.com
JWT_SECRET=YOUR_RANDOM_JWT_SECRET_KEY

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# Cloudflare R2 Object Storage
CLOUDFLARE_R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
CLOUDFLARE_R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
CLOUDFLARE_R2_BUCKET=fiwokan-production-evidence
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://evidence.fiwokan.com

# Resend Email Integration
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# Sentry Observability
SENTRY_DSN=https://YOUR_SENTRY_KEY@o0.ingest.sentry.io/0
