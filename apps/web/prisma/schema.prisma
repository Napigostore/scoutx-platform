generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REQUESTER
  SCOUT
  ADMIN
}

enum MissionCategory {
  STREET_CONDITIONS
  VENUE_STATUS
  LOCAL_EVENT
  PRODUCT_AVAILABILITY
  CROWD_DENSITY
  WEATHER_ON_SITE
  PHOTO_VERIFICATION
  GENERAL_OBSERVATION
  SURVEY
}

enum MissionStatus {
  DRAFT
  OPEN
  MATCHED
  IN_PROGRESS
  SUBMITTED
  VERIFIED
  PENDING_REQUESTER_ACCEPTANCE
  COMPLETED_PENDING_SETTLEMENT
  DISPUTED
  COMMUNITY_VOTING
  VOTING_FINALIZED
  SETTLEMENT_PENDING
  REWARDED
  COMPLETED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum MissionUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ScoutAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum MissionVisibility {
  PUBLIC
  PRIVATE
  INDIVIDUAL
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique
  displayName      String
  role             UserRole
  passwordHash     String
  avatarUrl        String?
  reliabilityScore Float    @default(50)
  freeMissions     Int      @default(3)

  // Notification Settings
  emailNotifyActivity Boolean @default(true)
  emailNotifyEvidence Boolean @default(true)
  emailNotifyReward   Boolean @default(true)
  emailNotifyDispute  Boolean @default(true)
  emailNotifySystem   Boolean @default(true)

  country   String?
  gender    String?
  birthDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userProfile                  UserProfile?
  scoutProfile                 ScoutProfile?
  requestedMissions            Mission[]                    @relation("RequestedMissions")
  submissions                  MissionSubmission[]
  evidence                     Evidence[]
  trustScore                   TrustScore?
  trustActionsGiven            TrustActionRecord[]          @relation("TrustActionsGiven")
  trustActionsReceived         TrustActionRecord[]          @relation("TrustActionsReceived")
  coinTransactions             CoinTransaction[]
  coinLedgers                  CoinLedger[]
  surveyParticipants           SurveyParticipant[]
  workerTrustProfile           WorkerTrustProfile?
  audienceProfile              AudienceProfile?
  savedAudiences               SavedAudience[]
  audienceMembers              AudienceMember[]
  researchParticipantHistories ResearchParticipantHistory[] @relation("WorkerHistory")
  researchBriefs               ResearchBrief[]
  sessions                     Session[]
  withdrawalRequests           WithdrawalRequest[]
  pendingAttachments           PendingAttachment[]
  receivedIndividualMissions   MissionRecipient[]           @relation("ReceivedIndividualMissions")
  disputesInitiated            Dispute[]                    @relation("DisputeInitiator")
  disputeEvidences             DisputeEvidence[]
  disputeVotes                 DisputeVote[]
  rewardRequests               RewardRequest[]
  notifications                Notification[]
  researchAnomalies            ResearchAnomaly[]
  optimizationEvents           OptimizationEvent[]
  apiKeys                      ApiKey[]
  webhookSubscriptions         WebhookSubscription[]

  @@map("users")
}

model Location {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  city        String
  country     String
  countryCode String @db.Char(2)
  latitude    Float
  longitude   Float
  timezone    String

  missions Mission[]
  scouts   ScoutProfile[]

  @@map("locations")
}

model ScoutProfile {
  id                     String            @id @default(uuid()) @db.Uuid
  userId                 String            @unique @db.Uuid
  displayName            String
  bio                    String
  availability           ScoutAvailability @default(AVAILABLE)
  reliabilityScore       Float             @default(50)
  completedMissions      Int               @default(0)
  categories             MissionCategory[]
  tags                   String[]
  homeLocationId         String            @db.Uuid
  currentLatitude        Float?
  currentLongitude       Float?
  maxRadiusMeters        Int               @default(5000)
  languages              String[]
  stripeConnectAccountId String?
  stripeConnectStatus    String?           @default("NOT_CONNECTED")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeLocation     Location            @relation(fields: [homeLocationId], references: [id])
  assignedMissions Mission[]           @relation("AssignedScout")
  submissions      MissionSubmission[]
  evidence         Evidence[]

  @@map("scout_profiles")
}

model Mission {
  id                            String            @id @default(uuid()) @db.Uuid
  title                         String
  description                   String
  category                      MissionCategory
  status                        MissionStatus     @default(DRAFT)
  urgency                       MissionUrgency    @default(NORMAL)
  visibility                    MissionVisibility @default(PUBLIC)
  publicLogs                    Boolean           @default(true)
  budgetCents                   Int
  currency                      String            @default("VND") @db.Char(3)
  locationId                    String            @db.Uuid
  latitude                      Float
  longitude                     Float
  radiusMeters                  Int               @default(1500)
  requesterId                   String            @db.Uuid
  assignedScoutId               String?           @db.Uuid
  winnerId                      String?           @db.Uuid
  requiredTags                  String[]
  targetCities                  String[]          @default([])
  targetGender                  String?           @default("ANY")
  targetAgeRange                String?           @default("ANY")
  targetExperienceLevel         String?           @default("ANY")
  targetLanguages               String[]          @default([])
  completionRequestedAt         DateTime?
  settlementStartedAt           DateTime?
  rewardReleasedAt              DateTime?
  rewardPerValidSubmissionCents Int?
  rewardBudgetCents             Int?
  remainingBudgetCents          Int?
  logVisibility                 String            @default("PRIVATE")
  selectionMode                 String            @default("AUTO")
  disputeMode                   String            @default("DISABLED")
  maxParticipants               Int?
  screeningEnabled              Boolean           @default(false)
  screeningQuestions            Json?
  quotas                        Json?
  minimumTrustScore             Int?
  minimumQualityScore           Int?
  minimumCompletedMissions      Int?
  verifiedOnly                  Boolean           @default(false)
  sourceBriefId                 String?           @db.Uuid
  expiresAt                     DateTime
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt

  location                     Location                     @relation(fields: [locationId], references: [id])
  requester                    User                         @relation("RequestedMissions", fields: [requesterId], references: [id])
  assignedScout                ScoutProfile?                @relation("AssignedScout", fields: [assignedScoutId], references: [id])
  submission                   MissionSubmission?
  evidence                     Evidence[]
  timelineEntries              TimelineEntry[]
  trustActions                 TrustActionRecord[]
  coinTransactions             CoinTransaction[]
  coinLedgers                  CoinLedger[]
  surveyParticipants           SurveyParticipant[]
  surveyQuestions              SurveyQuestion[]
  surveyResponses              SurveyResponse[]
  surveySubmissions            SurveySubmission[]
  recipients                   MissionRecipient[]
  dispute                      Dispute?
  rewardRequests               RewardRequest[]
  notifications                Notification[]
  researchParticipantHistories ResearchParticipantHistory[]
  fieldwork                    SurveyFieldwork?
  fieldworkEvents              FieldworkEvent[]
  researchAnomalies            ResearchAnomaly[]
  researchRecommendations      ResearchRecommendation[]
  optimizationRecommendations  OptimizationRecommendation[]
  optimizationEvents           OptimizationEvent[]
  samplingPlan                 SamplingPlan?

  @@index([status, expiresAt])
  @@index([locationId])
  @@index([requesterId])
  @@index([assignedScoutId])
  @@index([visibility])
  @@map("missions")
}

model MissionRecipient {
  id        String   @id @default(uuid()) @db.Uuid
  missionId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user    User    @relation("ReceivedIndividualMissions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId])
  @@index([userId])
  @@map("mission_recipients")
}

model MissionSubmission {
  id              String    @id @default(uuid()) @db.Uuid
  missionId       String    @unique @db.Uuid
  scoutId         String    @db.Uuid
  userId          String    @db.Uuid
  summary         String
  mediaUrls       String[]
  observedAt      DateTime
  latitude        Float
  longitude       Float
  verified        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?
  rejectionReason String?

  mission Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  scout   ScoutProfile @relation(fields: [scoutId], references: [id])
  user    User         @relation(fields: [userId], references: [id])

  @@index([missionId])
  @@index([scoutId])
  @@index([userId])
  @@map("mission_submissions")
}

enum EvidenceType {
  PHOTO
  VIDEO
  NOTE
}

enum TrustAction {
  VERIFIED
  DISPUTED
  ENDORSED
  BADGE_EARNED
}

model Evidence {
  id         String       @id @default(uuid()) @db.Uuid
  missionId  String       @db.Uuid
  scoutId    String       @db.Uuid
  userId     String       @db.Uuid
  caption    String
  type       EvidenceType @default(PHOTO)
  mediaUrl   String?
  latitude   Float?
  longitude  Float?
  location   String?
  verified   Boolean      @default(false)
  capturedAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  mission Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  scout   ScoutProfile @relation(fields: [scoutId], references: [id])
  user    User         @relation(fields: [userId], references: [id])

  @@index([missionId])
  @@index([scoutId])
  @@index([userId])
  @@map("evidence")
}

model TimelineEntry {
  id        String   @id @default(uuid()) @db.Uuid
  missionId String   @db.Uuid
  eventType String
  summary   String
  actorId   String?  @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
  @@index([createdAt])
  @@map("timeline_entries")
}

model TrustScore {
  userId    String   @id @db.Uuid
  score     Float    @default(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trust_scores")
}

model TrustActionRecord {
  id        String      @id @default(uuid()) @db.Uuid
  actorId   String      @db.Uuid
  targetId  String      @db.Uuid
  action    TrustAction
  missionId String?     @db.Uuid
  createdAt DateTime    @default(now())

  actor   User     @relation("TrustActionsGiven", fields: [actorId], references: [id])
  target  User     @relation("TrustActionsReceived", fields: [targetId], references: [id])
  mission Mission? @relation(fields: [missionId], references: [id])

  @@index([actorId])
  @@index([targetId])
  @@index([missionId])
  @@map("trust_actions")
}

model CoinTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  amountCents    Int
  currency       String   @default("VND") @db.Char(4)
  reason         String
  description    String?
  eventType      String
  missionId      String?  @db.Uuid
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id])

  @@index([userId])
  @@index([missionId])
  @@index([createdAt])
  @@map("coin_transactions")
}

model CoinLedger {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  missionId      String?  @db.Uuid
  type           String
  amount         Int
  currency       String   @default("VND") @db.Char(4)
  status         String   @default("COMPLETED")
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id])

  @@index([userId])
  @@index([missionId])
  @@index([createdAt])
  @@map("coin_ledgers")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  expiresAt    DateTime
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model WithdrawalRequest {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  amountCents       Int
  currency          String           @default("VND") @db.Char(3)
  status            WithdrawalStatus @default(PENDING)
  idempotencyKey    String           @unique
  providerReference String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("withdrawal_requests")
}

model PendingAttachment {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  storageKey String    @unique
  mediaUrl   String
  fileName   String
  mimeType   String
  consumed   Boolean   @default(false)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consumed, createdAt])
  @@map("pending_attachments")
}

model UserProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  bio                   String?
  expertise             String?
  livingCity            String?  @default("Ho Chi Minh City")
  livingCountry         String?  @default("Vietnam")
  livingCountryCode     String?  @default("VN")
  latitude              Float?   @default(10.7769)
  longitude             Float?   @default(106.7009)
  availableForMissions  Boolean  @default(true)
  missionCities         String[] @default(["Ho Chi Minh City"])
  skills                String[] @default([])
  preferredMissionTypes String[] @default([])

  // Private contact information (Owner + Admin ONLY)
  legalName    String?
  phone        String?
  privateNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Dispute {
  id          String   @id @default(uuid()) @db.Uuid
  missionId   String   @unique @db.Uuid
  initiatorId String   @db.Uuid
  reason      String
  fundedCoin  Int      @default(0)
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mission   Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  initiator User              @relation("DisputeInitiator", fields: [initiatorId], references: [id])
  evidences DisputeEvidence[]
  rounds    DisputeRound[]
  votes     DisputeVote[]

  @@map("disputes")
}

model DisputeEvidence {
  id          String   @id @default(uuid()) @db.Uuid
  disputeId   String   @db.Uuid
  ownerId     String   @db.Uuid
  fileUrl     String
  storageKey  String?
  explanation String
  createdAt   DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  owner   User    @relation(fields: [ownerId], references: [id])

  @@index([disputeId])
  @@map("dispute_evidences")
}

model DisputeRound {
  id               String    @id @default(uuid()) @db.Uuid
  disputeId        String    @db.Uuid
  roundNumber      Int       @default(1)
  minVotesRequired Int       @default(50)
  fundedCoin       Int       @default(0)
  durationDays     Int       @default(1)
  startsAt         DateTime  @default(now())
  endsAt           DateTime
  status           String    @default("ACTIVE") // ACTIVE | FINALIZED | TIE_REVIEW
  winningSide      String? // REQUESTER_WIN | WORKER_WIN | TIE
  finalizedAt      DateTime?
  createdAt        DateTime  @default(now())

  dispute Dispute       @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  votes   DisputeVote[]

  @@index([disputeId, roundNumber])
  @@map("dispute_rounds")
}

model DisputeVote {
  id           String   @id @default(uuid()) @db.Uuid
  disputeId    String   @db.Uuid
  roundId      String   @db.Uuid
  voterId      String   @db.Uuid
  selectedSide String // REQUESTER_WIN | WORKER_WIN
  rewardCoin   Int      @default(1)
  votedAt      DateTime @default(now())

  dispute Dispute      @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  round   DisputeRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  voter   User         @relation(fields: [voterId], references: [id])

  @@unique([roundId, voterId])
  @@index([disputeId])
  @@map("dispute_votes")
}

model RewardRequest {
  id        String   @id @default(uuid()) @db.Uuid
  missionId String   @db.Uuid
  userId    String   @db.Uuid
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([missionId, userId])
  @@index([missionId])
  @@index([userId])
  @@map("reward_requests")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  missionId String?  @db.Uuid
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([missionId])
  @@map("notifications")
}

model SurveyParticipant {
  id               String    @id @default(uuid()) @db.Uuid
  missionId        String    @db.Uuid
  userId           String    @db.Uuid
  evidenceId       String?   @db.Uuid
  status           String    @default("RESERVED") // INVITED | ELIGIBLE | RESERVED | IN_PROGRESS | SUBMITTED | QUALITY_REVIEW | ACCEPTED | REJECTED | DISQUALIFIED | ABANDONED | EXPIRED | PAID
  screeningStatus  String? // ELIGIBLE | SCREENED_OUT | NOT_REQUIRED
  screeningAnswers Json?
  profileSnapshot  Json?
  slotReservedAt   DateTime?
  startedAt        DateTime?
  selectedAt       DateTime?
  rewardedAt       DateTime?
  abandonedAt      DateTime?
  qualityScore     Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  mission         Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses       SurveyResponse[]
  samplingQuotaId String?            @db.Uuid
  samplingQuota   SamplingQuota?     @relation(fields: [samplingQuotaId], references: [id], onDelete: SetNull)
  submissions     SurveySubmission[]

  @@unique([missionId, userId])
  @@index([missionId, status])
  @@index([userId])
  @@map("survey_participants")
}

model SurveyQuestion {
  id          String   @id @default(uuid()) @db.Uuid
  missionId   String   @db.Uuid
  order       Int      @default(0)
  type        String // SINGLE_CHOICE | MULTIPLE_CHOICE | YES_NO | RATING | NUMBER | TEXT | MATRIX | PHOTO | VIDEO | AUDIO
  question    String
  description String?
  required    Boolean  @default(true)
  options     Json?
  validation  Json?
  condition   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mission   Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@index([missionId, order])
  @@map("survey_questions")
}

model SurveyResponse {
  id            String   @id @default(uuid()) @db.Uuid
  missionId     String   @db.Uuid
  participantId String   @db.Uuid
  questionId    String   @db.Uuid
  value         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mission     Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  participant SurveyParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question    SurveyQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([missionId, participantId, questionId])
  @@index([missionId])
  @@index([participantId])
  @@map("survey_responses")
}

model SurveySubmission {
  id              String    @id @default(uuid()) @db.Uuid
  missionId       String    @db.Uuid
  participantId   String    @db.Uuid
  status          String    @default("SUBMITTED") // STARTED | SUBMITTED | COMPLETED | REJECTED
  completionCode  String?
  startedAt       DateTime  @default(now())
  submittedAt     DateTime?
  completedAt     DateTime?
  durationSeconds Int?
  qualityScore    Float?
  qualityStatus   String? // PENDING | PASSED | FAILED | SUSPICIOUS
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mission     Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  participant SurveyParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([missionId, participantId])
  @@index([missionId, completionCode])
  @@map("survey_submissions")
}

model SurveyFieldwork {
  id                   String    @id @default(uuid()) @db.Uuid
  missionId            String    @unique @db.Uuid
  status               String    @default("RECRUITING") // RECRUITING | ACTIVE | PAUSED | QUOTA_FILLED | EXPIRED | COMPLETED | CANCELLED
  startedAt            DateTime?
  pausedAt             DateTime?
  completedAt          DateTime?
  expiresAt            DateTime
  targetCompletes      Int
  completedCount       Int       @default(0)
  screenedCount        Int       @default(0)
  rejectedCount        Int       @default(0)
  qualityRejectedCount Int       @default(0)
  disqualifiedCount    Int       @default(0)
  reservedCount        Int       @default(0)
  inProgressCount      Int       @default(0)
  remainingBudget      Float
  lastActivityAt       DateTime  @default(now())
  version              Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([expiresAt])
  @@map("survey_fieldwork")
}

model FieldworkEvent {
  id        String   @id @default(uuid()) @db.Uuid
  missionId String   @db.Uuid
  workerId  String?  @db.Uuid
  type      String // MISSION_STARTED | WORKER_JOINED | SCREENED | SCREENING_REJECTED | SURVEY_STARTED | SURVEY_SUBMITTED | QUALITY_ACCEPTED | QUALITY_REJECTED | QUOTA_FILLED | WORKER_REWARDED | WORKER_DISQUALIFIED | MISSION_PAUSED | MISSION_RESUMED | MISSION_COMPLETED | MISSION_EXPIRED
  metadata  Json?
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, createdAt])
  @@index([missionId, type])
  @@map("fieldwork_events")
}

model WorkerTrustProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  trustScore        Float    @default(50)
  qualityScore      Float    @default(50)
  fraudRiskScore    Float    @default(0)
  completedMissions Int      @default(0)
  approvedMissions  Int      @default(0)
  rejectedMissions  Int      @default(0)
  disputedMissions  Int      @default(0)
  wonMissions       Int      @default(0)
  surveyCompleted   Int      @default(0)
  surveyRejected    Int      @default(0)
  suspiciousCount   Int      @default(0)
  evidenceApproved  Int      @default(0)
  evidenceRejected  Int      @default(0)
  accountAgeDays    Int      @default(0)
  profileVerified   Boolean  @default(false)
  lastCalculatedAt  DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trustScore])
  @@index([qualityScore])
  @@index([fraudRiskScore])
  @@index([lastCalculatedAt])
  @@map("worker_trust_profiles")
}

model AudienceProfile {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @unique @db.Uuid
  country                 String
  region                  String?
  city                    String?
  languages               Json?
  employmentStatus        String?
  industry                String?
  jobTitle                String?
  education               String?
  incomeRange             String?
  deviceType              String?
  os                      String?
  skills                  Json?
  interests               Json?
  productUsage            Json?
  purchaseBehavior        Json?
  consentVersion          String?
  consentAt               DateTime?
  profileCompletedPercent Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([country])
  @@index([industry])
  @@index([jobTitle])
  @@map("audience_profiles")
}

model SavedAudience {
  id                     String   @id @default(uuid()) @db.Uuid
  requesterId            String   @db.Uuid
  name                   String
  description            String?
  criteria               Json
  estimatedEligibleCount Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  requester User             @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  members   AudienceMember[]

  @@index([requesterId])
  @@map("saved_audiences")
}

model AudienceMember {
  id              String    @id @default(uuid()) @db.Uuid
  audienceId      String    @db.Uuid
  workerId        String    @db.Uuid
  status          String    @default("ACTIVE") // ACTIVE | EXCLUDED | INACTIVE
  addedAt         DateTime  @default(now())
  lastQualifiedAt DateTime  @default(now())
  excludedAt      DateTime?

  audience SavedAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  worker   User          @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([audienceId, workerId])
  @@index([audienceId])
  @@index([workerId])
  @@index([status])
  @@map("audience_members")
}

model ResearchParticipantHistory {
  id           String    @id @default(uuid()) @db.Uuid
  workerId     String    @db.Uuid
  missionId    String    @db.Uuid
  requesterId  String    @db.Uuid
  status       String    @default("COMPLETED")
  completedAt  DateTime?
  qualityScore Float?
  rewardAmount Float?
  createdAt    DateTime  @default(now())

  worker  User    @relation("WorkerHistory", fields: [workerId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([workerId, missionId])
  @@index([workerId])
  @@index([requesterId])
  @@index([missionId])
  @@index([status])
  @@index([createdAt])
  @@map("research_participant_histories")
}

model ResearchBrief {
  id                       String   @id @default(uuid()) @db.Uuid
  requesterId              String   @db.Uuid
  title                    String
  objective                String
  market                   String?
  methodology              String?
  targetSampleSize         Int?
  estimatedDurationMinutes Int?
  budget                   Float?
  currency                 String?  @default("USD")
  rawBrief                 String
  status                   String   @default("DRAFT")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  requester User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  plan      ResearchPlan?

  @@index([requesterId])
  @@index([status])
  @@index([createdAt])
  @@map("research_briefs")
}

model ResearchPlan {
  id                     String   @id @default(uuid()) @db.Uuid
  briefId                String   @unique @db.Uuid
  audienceCriteria       Json
  screening              Json
  quota                  Json
  survey                 Json
  qualityPolicy          Json
  rewardPolicy           Json
  estimatedEligibleCount Int?
  estimatedCost          Float?
  warnings               Json?
  aiModel                String?
  aiVersion              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  brief ResearchBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId])
  @@map("research_plans")
}

model ResearchAnomaly {
  id         String    @id @default(uuid()) @db.Uuid
  missionId  String    @db.Uuid
  workerId   String?   @db.Uuid
  type       String // SPEEDING | LOW_QUALITY | DUPLICATE_PATTERN | SUSPICIOUS_CLUSTER | QUOTA_ANOMALY | RECRUITMENT_DROP | HIGH_ABANDONMENT | UNUSUAL_RESPONSE_PATTERN | DEVICE_PATTERN | GEO_ANOMALY
  severity   String // LOW | MEDIUM | HIGH | CRITICAL
  score      Float
  evidence   Json
  status     String    @default("OPEN") // OPEN | REVIEWED | RESOLVED | IGNORED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  worker  User?   @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([missionId, status])
  @@index([missionId, createdAt])
  @@index([missionId, type])
  @@map("research_anomalies")
}

model ResearchRecommendation {
  id             String    @id @default(uuid()) @db.Uuid
  missionId      String    @db.Uuid
  type           String // INCREASE_PRIORITY | PAUSE_SEGMENT | EXPAND_AUDIENCE | ADJUST_QUOTA | REVIEW_SCREENING | REVIEW_REWARD | RESUME_RECRUITMENT
  payload        Json
  rationale      String
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, status])
  @@index([missionId, createdAt])
  @@map("research_recommendations")
}

model OptimizationRecommendation {
  id                  String    @id @default(uuid()) @db.Uuid
  missionId           String    @db.Uuid
  title               String
  description         String
  category            String // QUOTA, REWARD, SCREENING, SCHEDULE, QUALITY
  confidenceScore     Float // 0-100
  projectedImpact     String
  suggestedAction     Json
  isAutoExecutable    Boolean   @default(false)
  requiresHumanReview Boolean   @default(true)
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXECUTED, STALE, DISCARDED
  reasoning           String
  idempotencyKey      String?   @unique
  version             Int       @default(1)
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  mission Mission             @relation(fields: [missionId], references: [id], onDelete: Cascade)
  events  OptimizationEvent[]

  @@index([missionId])
  @@index([status])
  @@map("optimization_recommendations")
}

model OptimizationEvent {
  id               String   @id @default(uuid()) @db.Uuid
  recommendationId String   @db.Uuid
  missionId        String   @db.Uuid
  actionType       String
  performedById    String?  @db.Uuid
  oldState         Json?
  newState         Json?
  reason           String?
  createdAt        DateTime @default(now())

  recommendation OptimizationRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  mission        Mission                    @relation(fields: [missionId], references: [id], onDelete: Cascade)
  performedBy    User?                      @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([recommendationId])
  @@index([missionId])
  @@map("optimization_events")
}

model SamplingPlan {
  id        String   @id @default(uuid()) @db.Uuid
  missionId String   @unique @db.Uuid
  strategy  String   @default("STRICT")
  variables Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mission Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  quotas  SamplingQuota[]

  @@map("sampling_plans")
}

model SamplingQuota {
  id             String   @id @default(uuid()) @db.Uuid
  planId         String   @db.Uuid
  criteria       Json
  targetCount    Int
  reservedCount  Int      @default(0)
  completedCount Int      @default(0)
  isFull         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plan         SamplingPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  participants SurveyParticipant[]

  @@index([planId])
  @@index([isFull])
  @@map("sampling_quotas")
}

model ApiKey {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  keyPrefix        String
  keyHash          String    @unique
  userId           String    @db.Uuid
  scopes           String[]  @default(["read", "write"])
  rateLimitPerMin  Int       @default(60)
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  revoked          Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
  @@map("api_keys")
}

model WebhookSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  url       String
  secret    String
  events    String[] @default(["MISSION_COMPLETED", "EVIDENCE_UPLOADED", "QUOTA_REACHED"])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webhook_subscriptions")
}

